.DS_Store
# No trailing slash on purpose: "node_modules/" matches a DIRECTORY only, so a
# worktree that symlinks node_modules (scripts/ops/audit-worktree.sh in boss-os
# does) left the symlink unignored, and `git add -A` tracked it. That is how a
# node_modules entry reached the source snapshot twice - see commit 57d997df7,
# "Remove tracked node_modules from source snapshot" - and phase-tree-hygiene
# hard-fails on it. Without the slash it matches the directory and the symlink.
node_modules
.build/
dist/
.build-cache/
reports/
artifacts/validation/runtime/
*.log
*.zip
data/community/scored_signals.json
logs/
artifacts/diagnostics/
artifacts/validation/release-pipeline-checkpoint.json
artifacts/validation/release-pipeline-report.json
__pycache__/
artifacts/validation/validation-summary-shard-*.json
