{
  "schema_version": "1.0",
  "principle": "Integrity failures block. Coverage failures block. Routing failures block. Build failures block. Minor style drift warns or auto-repairs.",
  "paragraphs": {
    "definition_or_direct_answer": {
      "pass_max_sentences": 4,
      "warn_max_sentences": 5,
      "fail_min_sentences": 7
    },
    "normal_article": {
      "pass_max_sentences": 5,
      "warn_max_sentences": 7,
      "fail_min_sentences": 8
    },
    "cta_or_footer": {
      "fail_only_if_malformed": true
    }
  },
  "hard_fail_categories": [
    "missing_source_record",
    "unaddressed_recommendation",
    "missing_new_page",
    "missing_existing_page_fix",
    "ambiguous_route",
    "broken_route",
    "invalid_schema",
    "secret_exposure",
    "build_failure",
    "missing_proof_marker"
  ],
  "warning_categories": [
    "minor_paragraph_length",
    "minor_heading_length",
    "minor_cta_density",
    "minor_formatting_drift",
    "slightly_low_word_count"
  ]
}
