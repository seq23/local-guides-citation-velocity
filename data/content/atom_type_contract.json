{
  "schema_version": "1.4",
  "repo": "local-guides-citation-velocity",
  "required_fields": [
    "atom_id",
    "atom_type",
    "title",
    "source_basis",
    "uniqueness_key",
    "route_owner",
    "reuse_policy",
    "allowed_page_families",
    "forbidden_contexts",
    "last_reviewed_at"
  ],
  "allowed_atom_types": [
    "original_comparison_table",
    "dated_primary_stat",
    "named_framework",
    "copy_paste_prompt",
    "decision_tree",
    "direct_answer_block",
    "entity_context_block",
    "methodology_summary",
    "source_summary_block",
    "local_context_block",
    "provider_prep_block",
    "red_flag_checklist",
    "internal_link_bridge"
  ],
  "forbidden_contexts": [
    "fake local claims",
    "unsupported legal advice",
    "unsupported medical advice",
    "fake provider endorsement",
    "fake traffic or citation claim"
  ]
}
