{
  "schema_version": "4.0",
  "authority": "Canonical Velocity workflow topology with separate Search Intelligence observation/retest lane and exact-SHA CI health alert/recovery loop. Scheduled Search Intelligence does not commit source changes or alter publishing cadence.",
  "global_contract": {
    "node_version": "24",
    "node_options": "--max-old-space-size=3072",
    "maximum_workflows_on_push": 2,
    "maximum_scheduled_mutation_workflows": 1,
    "allowed_push_workflows": [
      "validate-repo.yml",
      "velocity-content-release.yml"
    ],
    "retired_workflows": [
      "validate.yml",
      "velocity_content_release.yml",
      "release_batch.yml",
      "velocity_full_rebuild.yml",
      "postdeploy_public_audit.yml",
      "insights_gate.yml",
      "medium_articles_gate.yml",
      "public-signal-processing.yml",
      "lkg_pr_push.yml"
    ],
    "forbidden_actions": [
      "peter-evans/create-pull-request",
      "git push to another repository",
      "LKG_REPO",
      "LKG_TOKEN"
    ],
    "allowed_scheduled_mutation_workflows": [
      "query-evidence-refresh.yml"
    ],
    "scheduled_mutation_policy": "Scheduled workflows may commit to main, but only those named in allowed_scheduled_mutation_workflows, and only after the full validation chain passes in the same run. This was 0 while every change arrived through an external agent-run manifest. Content-factory lanes are now permitted to write on a timer; the allowlist keeps that an explicit decision per workflow rather than a general licence for anything scheduled to push."
  },
  "workflows": [
    {
      "file": "ci-health-recovery.yml",
      "name": "CI Health Red Recovery",
      "lane": "ci-health",
      "triggers": [
        "workflow_run:Validate Repo",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "contents: read",
        "issues: write"
      ],
      "timeout_minutes": 15,
      "commands": [
        "node scripts/search_intelligence/ci_health_alert.js"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "Validate Repo exact-SHA workflow conclusion"
      ],
      "produces": [
        "automation health receipt",
        "governed GitHub issue alert/recovery state"
      ],
      "upstream": [
        "validate-repo.yml"
      ],
      "downstream": [],
      "failure_boundary": "A RED exact-SHA result is recorded and surfaced; no success state is inferred from a failed or unobserved run."
    },
    {
      "file": "daily-citation-intelligence.yml",
      "name": "Daily Citation Intelligence",
      "lane": "signal-intelligence",
      "triggers": [
        "schedule:17-13-utc",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "contents: read"
      ],
      "timeout_minutes": 30,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run release:daily-citation-intelligence"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "traffic-qualified fixtures",
        "source registry",
        "strategy contract"
      ],
      "produces": [
        "data/signals/**",
        "artifacts/validation/**",
        "reports/**"
      ],
      "upstream": [],
      "downstream": [],
      "failure_boundary": "Signal intelligence may update generated state but must not commit governance or source authority files."
    },
    {
      "file": "deploy-distribution.yml",
      "name": "Deploy Distribution",
      "lane": "deploy",
      "triggers": [
        "workflow_run:Validate Repo",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "actions: read",
        "contents: read"
      ],
      "timeout_minutes": 30,
      "commands": [
        "node scripts/prepare_distribution_from_attestation.js",
        "distribution_scripts/deploy_distribution.sh"
      ],
      "required_inputs": [
        "artifact_name",
        "artifact_run_id",
        "commit_sha"
      ],
      "required_secrets": [],
      "optional_secrets": [
        "INDEXNOW_KEY",
        "GSC_SERVICE_ACCOUNT_JSON",
        "GSC_SITE_URL"
      ],
      "consumes": [
        "velocity-validated-{commit_sha}",
        "artifacts/release/validation-attestation.json",
        ".build/indexnow-priority.txt",
        ".build/indexnow-batch.txt"
      ],
      "produces": [
        "distribution evidence"
      ],
      "upstream": [
        "validate-repo.yml"
      ],
      "downstream": [
        "postdeploy-public-audit.yml"
      ],
      "failure_boundary": "The exact artifact commit SHA must match the validation attestation before distribution."
    },
    {
      "file": "postdeploy-public-audit.yml",
      "name": "Postdeploy Public Audit",
      "lane": "postdeploy-audit",
      "triggers": [
        "workflow_run:Deploy Distribution",
        "schedule:23-11-utc-tue-fri",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "contents: read"
      ],
      "timeout_minutes": 45,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run postdeploy:public-click-audit"
      ],
      "required_inputs": [
        "base_url"
      ],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "deployed Velocity base URL"
      ],
      "produces": [
        "artifacts/diagnostics/click-audit/**"
      ],
      "upstream": [
        "deploy-distribution.yml"
      ],
      "downstream": [],
      "failure_boundary": "Requires real deployed URL and Playwright browser runtime; container browserless mock backup is not a substitute."
    },
    {
      "file": "query-evidence-refresh.yml",
      "name": "Query Evidence Refresh",
      "lane": "query-evidence",
      "triggers": [
        "schedule:23-06-utc",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": true,
      "permissions": [
        "contents: write"
      ],
      "timeout_minutes": 30,
      "commands": [
        "npm ci --ignore-scripts",
        "python3 scripts/queries/ingest_gsc_evidence.py",
        "npm run atlas:build",
        "npm run validate"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [
        "GSC_SERVICE_ACCOUNT_JSON",
        "GSC_SITE_URL"
      ],
      "consumes": [
        "Google Search Console search-analytics query rows for the verified property",
        "existing evidence_queries.json (merged, never replaced)"
      ],
      "produces": [
        "data/queries/evidence/evidence_queries.json",
        "data/authority_scale/query_atlas.json"
      ],
      "upstream": [],
      "downstream": [
        "velocity-content-release.yml"
      ],
      "failure_boundary": "Ingests measured Search Console demand, rebuilds the atlas, and commits only if the full validation chain passes in the same run. Named in allowed_scheduled_mutation_workflows. It has no page-admission authority: publishing stays gated by atlas evidence tiers and the release workflow. Missing credentials leave the evidence untouched and exit 0; a credentialed API failure is a hard error."
    },
    {
      "file": "search-intelligence-loop.yml",
      "name": "Search Intelligence Closed Loop",
      "lane": "search-intelligence",
      "triggers": [
        "schedule:41-14-utc",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "contents: read"
      ],
      "timeout_minutes": 45,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run search:intelligence:closed-loop",
        "npm run validate:search-intelligence"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "admitted route registry",
        "read-only Agent Run normalization",
        "optional provider truth evidence",
        "source/claim registries"
      ],
      "produces": [
        "data/search_intelligence/**",
        "Search Intelligence validation receipts"
      ],
      "upstream": [
        "daily-citation-intelligence.yml"
      ],
      "downstream": [],
      "failure_boundary": "Scheduled lane observes, diagnoses, queues, retests, and reports only. It has no independent page-admission, cadence, or repo-commit authority."
    },
    {
      "file": "validate-repo.yml",
      "name": "Validate Repo",
      "lane": "validate",
      "triggers": [
        "push:main",
        "pull_request",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": false,
      "permissions": [
        "contents: read"
      ],
      "timeout_minutes": 60,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run strategy:gate",
        "npm run release:daily-citation-intelligence:preview",
        "npm run release:ci-validate"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "repository source",
        "package-lock.json",
        "validation registry"
      ],
      "produces": [
        "velocity-validated-{commit_sha}",
        "validation diagnostics"
      ],
      "upstream": [],
      "downstream": [
        "deploy-distribution.yml"
      ],
      "failure_boundary": "No artifact is uploaded as validated unless the staged container release passes."
    },
    {
      "file": "velocity-content-release.yml",
      "name": "Velocity Content Release",
      "lane": "content-release",
      "triggers": [
        "push:agent_run_manifest",
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": true,
      "permissions": [
        "contents: write"
      ],
      "timeout_minutes": 120,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run release:daily-citation-intelligence:preview",
        "npm run release:velocity-intake",
        "npm run validate:agent-exact",
        "npm run validate:citation-agent-fixes",
        "npm run build",
        "npm run validate:release",
        "python3 scripts/queries/ingest_gsc_evidence.py",
        "npm run atlas:build"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [
        "GSC_SERVICE_ACCOUNT_JSON",
        "GSC_SITE_URL"
      ],
      "consumes": [
        "Twin Agent ready manifests",
        "traffic-qualified preview proof",
        "staged Velocity source"
      ],
      "produces": [
        "validated Velocity release commit",
        "release diagnostics",
        "data/queries/evidence/evidence_queries.json",
        "data/authority_scale/query_atlas.json"
      ],
      "upstream": [
        "validate-repo.yml"
      ],
      "downstream": [
        "deploy-distribution.yml"
      ],
      "failure_boundary": "Push only after Safe Harbor/transactional release finalization, deterministic rebuild, release validation, exact-agent validation, and citation-fix validation pass."
    },
    {
      "file": "velocity-full-rebuild.yml",
      "name": "Velocity Full Rebuild",
      "lane": "full-rebuild",
      "triggers": [
        "workflow_dispatch"
      ],
      "manual_ready": true,
      "mutates_repo": true,
      "permissions": [
        "contents: write"
      ],
      "timeout_minutes": 75,
      "commands": [
        "npm ci --ignore-scripts",
        "npm run intelligence:build",
        "npm run release:full-rebuild",
        "npm run build",
        "npm run validate:release"
      ],
      "required_inputs": [],
      "required_secrets": [],
      "optional_secrets": [],
      "consumes": [
        "repository source",
        "citation strategy gate",
        "frozen accepted-output registry"
      ],
      "produces": [
        "validated rebuild commit",
        "rebuild diagnostics"
      ],
      "upstream": [],
      "downstream": [
        "deploy-distribution.yml"
      ],
      "failure_boundary": "Push only after deterministic frozen-aware rebuild and release validation pass; broad self-healing is not permitted in the rebuild workflow."
    }
  ]
}
