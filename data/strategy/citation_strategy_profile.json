{
  "schema_version": "1.4",
  "repo": "seq23/local-guides-citation-velocity",
  "repo_name": "local-guides-citation-velocity",
  "repo_class": "CLASS_2_GENERATED_STATIC_PUBLISHING_CITATION_VELOCITY",
  "primary_outcome": "traffic-qualified local and vertical editorial reference demand capture",
  "primary_kpi": {
    "name": "monthly_visitors",
    "target_value": 100000,
    "time_horizon_days": 180,
    "measurement_required": true,
    "validator_claim_allowed": false
  },
  "secondary_outcomes": [
    "100K citation-ready opportunities/surfaces in 180 days or less",
    "$0 citation intelligence and free-win self-healing",
    "query fanout universe and route admission planning",
    "qualified citation/surfacing opportunities",
    "AEO answer blocks",
    "GEO entity/context blocks",
    "SEO route coverage",
    "source-backed content atoms",
    "internal-link graph strength",
    "sitemap and llms coverage"
  ],
  "target_domains": [
    "theindustryguides.com"
  ],
  "verticals": [
    "personal-injury",
    "dentistry",
    "neuro",
    "uscis",
    "trt"
  ],
  "audiences": [
    "local service researchers",
    "high-intent comparison searchers",
    "answer-engine users",
    "editorial reference consumers"
  ],
  "products_or_destinations": [
    "Velocity generated pages",
    "Guides",
    "State/support pages",
    "Question pages",
    "Disambiguators",
    "Atlas",
    "llms exports"
  ],
  "page_families": [
    "guide",
    "state_support",
    "literal_question",
    "disambiguator",
    "atlas",
    "methodology",
    "glossary"
  ],
  "query_families": [
    "what_to_ask",
    "cost",
    "timeline",
    "red_flags",
    "near_me_comparison",
    "verification",
    "provider_prep",
    "state_specific"
  ],
  "aeo_strategy": {
    "required_blocks": [
      "direct_answer",
      "faq",
      "decision_tree",
      "comparison_table",
      "source_summary"
    ],
    "rule": "answer extraction requires neutral educational boundaries and no fake claims"
  },
  "geo_strategy": {
    "required_blocks": [
      "entity_context",
      "methodology_summary",
      "publisher_identity",
      "llms_exports"
    ],
    "rule": "entity and methodology context must be truthful and source-bounded"
  },
  "seo_strategy": {
    "required_blocks": [
      "topic_cluster",
      "internal_links",
      "sitemap_parity",
      "canonical_noindex_policy"
    ],
    "rule": "increase useful surface area without duplicate indexable intent or thin fanout"
  },
  "citation_strategy": {
    "model": "four-layer citation velocity",
    "citation_ready_target": 100000,
    "citation_ready_time_horizon_days": 180,
    "hard_guarantee": false,
    "rule": "signals and fanout intelligence inform release plans; release plans govern publication; opportunities and owned surfaces are not external citation claims"
  },
  "signal_strategy": {
    "default_mode": "SHADOW_MODE",
    "live_firehose": "disabled_until_terms_credentials_and_telemetry_exist",
    "active_sources": [
      "fixture",
      "manual_import",
      "agent_artifacts"
    ],
    "shadow_sources": [
      "forums_rss",
      "reddit",
      "bluesky",
      "x",
      "youtube",
      "search_console"
    ]
  },
  "cadence": {
    "daily_target_units": 5,
    "weekly_review_day": "Wednesday",
    "max_new_pages_per_day": 2,
    "max_repairs_per_day": 2,
    "max_atom_updates_per_day": 3,
    "max_internal_link_updates_per_day": 5,
    "max_route_mutations_per_day": 0,
    "cadence_class": "CADENCE_DAILY_LIGHT_SAFE_HARBOR",
    "batch_d_status": "SAFE_HARBOR_AUTONOMOUS_PROCESSING",
    "daily_processing_budget_units": 5,
    "daily_target_units_semantics": "DEPRECATED_COMPATIBILITY_ALIAS_FOR_PROCESSING_BUDGET_NOT_PUBLICATION_QUOTA",
    "publication_quota": false,
    "max_new_pages_per_day_semantics": "SAFETY_CAP_NOT_MINIMUM"
  },
  "structural_graph_live_policy": "preserve_all_staged_structural_pages_live_when_graph_critical",
  "proof_kpis": [
    "signals_collected",
    "signals_normalized",
    "clusters_created",
    "release_units_planned",
    "release_units_applied",
    "blocked_units",
    "citation_surfaces_total",
    "indexable_routes_total",
    "sitemap_urls_total",
    "llms_entries_total"
  ],
  "stop_conditions": [
    "external telemetry absent cannot claim traffic",
    "source terms blocked",
    "credential required",
    "duplicate intent",
    "thin page risk",
    "unsupported medical/legal/financial claim",
    "workflow attempts governance mutation"
  ]
}
