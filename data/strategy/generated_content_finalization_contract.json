{
  "schema_version": "1.0",
  "repo": "local-guides-citation-velocity",
  "contract": "Every generated or generated-adjacent content release must self-heal and prevalidate before it can be considered finished.",
  "applies_to": [
    "agent artifact pages to build",
    "agent exact repairs",
    "manual/imported strategy gap-fill candidates",
    "social/manual fallback candidates admitted for release",
    "programmatic state/support pages",
    "daily citation-intelligence release candidates"
  ],
  "required_finish_sequence": [
    "build_or_mutate_source_content",
    "self_heal_source_content",
    "validate_programmatic_substance",
    "build_rendered_site",
    "validate_rendered_programmatic_substance",
    "validate_rich_new_page_contract",
    "validate_page_family_contract",
    "write_evidence_artifact"
  ],
  "release_blocking": true,
  "forbidden_finish_states": [
    "generated_without_self_healing",
    "generated_without_source_validation",
    "generated_without_render_validation",
    "agent_content_finished_without_finalizer",
    "gap_fill_content_finished_without_finalizer"
  ],
  "finish_command": "npm run release:content-finalize",
  "evidence_file": "artifacts/validation/generated-content-finalization-contract.json"
}
