{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velocity provider evidence",
  "type": "object",
  "required": [
    "provider_name",
    "official_url",
    "vertical",
    "geography",
    "evidence",
    "checked_at"
  ],
  "properties": {
    "provider_name": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "vertical": {
      "type": "string"
    },
    "geography": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    },
    "ordering_method": {
      "enum": [
        "unranked_shortlist",
        "alphabetical_shortlist",
        "category_grouped_shortlist"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_url"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "observed_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
