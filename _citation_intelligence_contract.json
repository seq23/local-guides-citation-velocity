{
  "schema_version": "2.1",
  "repo": "local-guides-citation-velocity",
  "mode": "SHADOW_MODE",
  "live_firehose_enabled": false,
  "external_telemetry_present": false,
  "telemetry_claims_allowed": false,
  "source_compliance_law": "No unauthorized scraping, no fake credentials, no live source claims without source authority.",
  "adapter_contract": {
    "required_fields": [
      "adapter",
      "source",
      "mode",
      "terms_status",
      "collected_at",
      "records",
      "errors",
      "warnings",
      "status"
    ],
    "allowed_status": [
      "PASS",
      "WARN",
      "BLOCKED",
      "FAIL"
    ],
    "allowed_terms_status": [
      "allowed",
      "requires_review",
      "requires_credentials",
      "blocked"
    ]
  },
  "required_outputs": [
    "data/strategy/citation_growth_strategy.json",
    "data/queries/citation_fanout_opportunities_100k/index.json",
    "data/measurement/citation_honesty_scoreboard.json",
    "data/measurement/zero_dollar_citation_test_ledger.json",
    "data/measurement/free_win_self_heal_queue.json",
    "data/signals/raw/latest.json",
    "data/signals/normalized/latest.json",
    "data/signals/source_health.json",
    "data/signals/firehose_ledger.json",
    "artifacts/validation/citation-100k-runway.json",
    "artifacts/validation/fixture-signal-trace.json",
    "artifacts/validation/daily-citation-release-plan.json",
    "artifacts/validation/daily-proof-packet.json"
  ],
  "forbidden_claims": [
    "actual traffic",
    "actual rankings",
    "actual indexing",
    "actual LLM citations",
    "actual third-party backlinks",
    "actual conversions"
  ],
  "promotion_gates": [
    "strategy_patched",
    "contracts_installed",
    "offline_fixture_trace_passes",
    "shadow_signal_run_passes",
    "release_planner_preview_passes",
    "controlled_release_or_valid_noop",
    "build_and_validators_pass",
    "proof_packet_passes",
    "postdeploy_or_browser_fallback_passes",
    "scheduled_cadence_enabled"
  ],
  "fanout_storage": {
    "format": "indexed_json_shards",
    "index": "data/queries/citation_fanout_opportunities_100k/index.json",
    "legacy_monolith_forbidden": "data/queries/citation_fanout_opportunities_100k.json",
    "expected_records": 100000,
    "integrity": "every shard hash/count plus aggregate hash must validate before release or packaging"
  }
}
