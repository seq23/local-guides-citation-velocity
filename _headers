/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://*.clarity.ms https://static.cloudflareinsights.com; connect-src 'self' https://*.clarity.ms https://cloudflareinsights.com; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: one Cache-Control per URL, with s-maxage so the zone cache can hold
# them (config/cloudflare/zone_cache_rules.json makes HTML cache-eligible at all;
# without that rule every page answered cf-cache-status: DYNAMIC). Pages joins the
# values of every rule a URL matches, so these patterns must not overlap:
#   /                  the homepage
#   /*/                every directory route (hubs, guides, questions, atlas, ...)
#   /insights/:slug    the extensionless insight pages
#   /about ...         the extensionless root pages
# validate_network_crawler_contract.js checks every served URL gets exactly one.
/
  Cache-Control: public, max-age=300, s-maxage=3600

/*/
  Cache-Control: public, max-age=300, s-maxage=3600

