{
  "schema_version": "1.0",
  "required_wrapper": "local-guides-citation-velocity-main",
  "excluded": [
    ".git",
    "node_modules",
    ".env",
    ".env.*",
    "dist",
    ".build",
    "logs",
    "artifacts/validation/runtime",
    "*.log",
    "*.zip"
  ],
  "required": [
    "REPO_IDENTITY.md",
    "_repo_update_contract.json",
    "_repo_lifecycle_profile.json",
    "_repo_validation_matrix.json",
    "_validation_registry.json",
    "package.json",
    "package-lock.json",
    "content/_staged/pages.json",
    "data/citation_velocity/recommendations.json",
    "data/content/programmatic_content_standard.json",
    "content/_live/insight_quarantine.json",
    "scripts/validators/validate_generated_content_gate.js",
    "data/overhaul/full_scope_overhaul_contract.json",
    "data/evidence/source_registry.json",
    "data/evidence/claim_registry.json",
    "data/routing/canonical_destination_registry.json",
    "data/network/crawler_policy.json",
    "data/page_families/velocity_page_specs.json",
    "artifacts/release/VELOCITY_ONLY_MASTER_PLAN_COMPLETION_CHECKLIST.md",
    "artifacts/release/validation-attestation.json",
    "artifacts/release/HOSTILE_REVIEW_FINAL.md",
    "artifacts/release/HOSTILE_REVIEW_FINAL.json",
    "artifacts/release/FUTURE_PAGE_APPEND_PROOF.json",
    "artifacts/validation/workflow-data-trace.md",
    "data/strategy/citation_dominance_contract.json",
    "data/strategy/citation_dominance_gap_registry.json",
    "artifacts/release/STRATEGY_ALIGNMENT_MATRIX.md",
    "artifacts/release/STRATEGY_ALIGNMENT_MATRIX.json",
    "artifacts/release/VALIDATOR_HOSTILE_REVIEW.md",
    "artifacts/release/VALIDATOR_HOSTILE_REVIEW.json",
    "reports/workflow-yaml-inventory.md",
    "reports/fixture-signal-trace.md",
    "reports/daily-proof-packet.md",
    "reports/daily-citation-release-plan.json"
  ],
  "hash_manifest": "_artifact_validation_manifest.json",
  "reopen_and_verify": true,
  "updater_required_runtime_artifacts": [
    "data/site.json",
    "dist/",
    "coverage_targets.csv",
    "coverage_runtime_support.csv",
    "coverage_promoted.csv"
  ],
  "packaging_note": "Repo hygiene keeps generated runtime artifacts gitignored; the external LKG updater still requires these files/directories inside delivered baseline ZIPs."
}
